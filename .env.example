# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase — commandes partagées entre appareils
# Variables serveur Vercel (jamais exposées au navigateur)
# SUPABASE_SECRET_KEY = clé secrète sb_secret_... (rôle service_role)
SUPABASE_URL="https://votre-projet.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_VOTRE_CLE_SECRETE"
SUPABASE_JWT_SECRET="VOTRE_SECRET_JWT_SUPABASE"
# Optionnel mais recommandé si Supabase affiche un Key ID pour le Legacy JWT Secret
SUPABASE_JWT_KID="VOTRE_KEY_ID_JWT_OU_VIDE"
SESSION_SECRET="VOTRE_SECRET_DE_SESSION_LONG_ET_ALEATOIRE"
ORDER_DELIVERY_FEE_DA="200"

# Variables navigateur Vite (clé publique uniquement)
# VITE_SUPABASE_PUBLISHABLE_KEY = clé sb_publishable_...
VITE_SUPABASE_URL="https://votre-projet.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_VOTRE_CLE_PUBLIQUE"

# Compatibilité legacy acceptée par le code :
# SUPABASE_SERVICE_ROLE_KEY="ANCIENNE_CLE_SERVICE_ROLE_JWT"
# VITE_SUPABASE_ANON_KEY="ANCIENNE_CLE_ANON_JWT"
